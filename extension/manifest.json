{
  "manifest_version": 3,
  "name": "WikiBridge — Cross-Lingual Fact Checker (FI · SV · RU)",
  "version": "1.0.0",
  "description": "Find factual discrepancies, missing citations, and non-neutral emotional tone across FI, SV, RU, EN, ET, and ES Wikipedia and jump directly to the passage.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open WikiBridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "src/background/serviceWorker.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://fi.wikipedia.org/*",
    "https://sv.wikipedia.org/*",
    "https://ru.wikipedia.org/*",
    "https://en.wikipedia.org/*",
    "https://et.wikipedia.org/*",
    "https://es.wikipedia.org/*",
    "https://www.wikidata.org/*",
    "http://localhost:4000/*",
    "http://127.0.0.1:4000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://fi.wikipedia.org/*",
        "https://sv.wikipedia.org/*",
        "https://ru.wikipedia.org/*",
        "https://en.wikipedia.org/*",
        "https://et.wikipedia.org/*",
        "https://es.wikipedia.org/*"
      ],
      "css": ["src/content/contentStyles.css"],
      "js": ["src/content/contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
