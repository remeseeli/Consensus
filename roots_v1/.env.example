# MariaDB 11.7+ credentials
MARIADB_ROOT_PASSWORD=root_secret_change_me
DB_HOST=db
DB_PORT=3306
DB_NAME=wiki_rag
DB_USER=wiki_user
DB_PASSWORD=wiki_pass

# Embeddings: "local" (all-MiniLM-L6-v2, 384-dim) or "openai"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# LLM for RAG: "auto" (uses OpenAI-compatible API if configured, else extractive fallback), "openai", or "extractive"
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Topic cache & retrieval
TOPIC_CACHE_TTL_HOURS=24
RAG_TOP_K=6